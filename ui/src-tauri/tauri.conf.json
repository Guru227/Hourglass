{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hourglass",
  "mainBinaryName": "hourglass-ui",
  "version": "0.7.0",
  "identifier": "com.guru227.hourglass",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
